{
  "name": "tienda",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @tienda/db migrate",
    "db:seed": "pnpm --filter @tienda/db seed",
    "db:studio": "pnpm --filter @tienda/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
