DATABASE_URL="postgresql://tienda:tienda@localhost:5432/tienda?schema=public"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Firma de las sesiones del panel (/admin). Mínimo 32 caracteres: openssl rand -hex 32
# Sin esta variable el panel queda apagado y la tienda pública sigue funcionando.
AUTH_SECRET=""
# Direcciones de la tienda, separadas por coma. En producción la API solo devuelve al
# comprador (después de pagar) a una de estas. Agrega aquí tu dominio propio.
WEB_ORIGIN="http://localhost:3000"
