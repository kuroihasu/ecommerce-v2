// Modelo de datos de la plantilla ecommerce.
// Todo cuelga de `Store` (la tienda de cada pyme), así la misma base sirve
// hoy para una sola tienda y mañana para la plataforma de varias tiendas.
// Los montos se guardan como enteros en la moneda de la tienda (CLP no tiene decimales).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Tienda y equipo ────────────────────────────────────────────────

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  domain    String?  @unique
  currency  String   @default("CLP")
  // Tokens de marca (colores, tipografías, logo) que usa el front para tematizar la tienda.
  theme     Json     @default("{}")
  // Datos de contacto, redes, políticas, etc.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    StoreMember[]
  categories Category[]
  products   Product[]
  customers  Customer[]
  carts      Cart[]
  orders     Order[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships StoreMember[]
}

enum StoreRole {
  OWNER
  ADMIN
  STAFF
}

model StoreMember {
  id      String    @id @default(cuid())
  storeId String
  userId  String
  role    StoreRole @default(STAFF)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
}

// ─── Catálogo ───────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  storeId     String
  parentId    String?
  name        String
  slug        String
  description String?
  imageUrl    String?
  position    Int     @default(0)

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  categoryId  String?
  name        String
  slug        String
  description String?
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  // Etiquetas libres para filtrar y destacar: "nuevo", "preventa", "ultimas", "mujer", "hombre"...
  tags        String[]      @default([])
  // Datos de ficha que no necesitan columna propia:
  // { "short": "...", "details": ["..."], "colors": [{ "name": "Negro", "hex": "#111111" }] }
  attributes  Json          @default("{}")
  // Peso y dimensiones por defecto para cotizar envíos (gramos / centímetros).
  weightGrams Int?
  lengthCm    Int?
  widthCm     Int?
  heightCm    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images   ProductImage[]
  variants ProductVariant[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  // Si la foto es de un color en particular (coincide con options.Color de la variante).
  color     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// Todo producto tiene al menos una variante: ahí viven precio, SKU y stock.
model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  sku            String?
  name           String  @default("Default")
  // Ej: { "Talla": "M", "Color": "Negro" }
  options        Json    @default("{}")
  price          Int
  compareAtPrice Int?
  stock          Int     @default(0)
  position       Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, position])
}

// ─── Clientes ───────────────────────────────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  storeId      String
  email        String
  name         String?
  phone        String?
  rut          String?
  passwordHash String?
  createdAt    DateTime @default(now())

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses Address[]
  carts     Cart[]
  orders    Order[]

  @@unique([storeId, email])
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  fullName   String
  phone      String?
  region     String
  comuna     String
  street     String
  number     String
  apartment  String?
  notes      String?
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// ─── Carrito ────────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  storeId    String
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ─── Pedidos, pagos y envíos ────────────────────────────────────────

enum OrderStatus {
  PENDING   // creado, esperando pago
  PAID
  FULFILLED // despachado
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  storeId         String
  // Número correlativo visible para el cliente, por tienda.
  number          Int
  customerId      String?
  email           String
  status          OrderStatus @default(PENDING)
  subtotal        Int
  shippingTotal   Int         @default(0)
  discountTotal   Int         @default(0)
  total           Int
  // Copia de la dirección al momento de la compra.
  shippingAddress Json
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]
  shipments Shipment[]

  @@unique([storeId, number])
  @@index([storeId, status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  variantId String?
  // Copia de nombre, SKU y precio al momento de la compra.
  name      String
  sku       String?
  unitPrice Int
  quantity  Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

enum PaymentProvider {
  WEBPAY
  MERCADOPAGO
  FLOW
  TRANSFER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  FAILED
  REFUNDED
}

model Payment {
  id         String          @id @default(cuid())
  orderId    String
  provider   PaymentProvider
  status     PaymentStatus   @default(PENDING)
  amount     Int
  // Token o id de la transacción en la pasarela.
  externalId String?
  // Respuesta cruda de la pasarela, para auditoría.
  raw        Json?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, externalId])
}

enum ShipmentStatus {
  PENDING
  READY
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  // Ej: "chilexpress", "starken", "blueexpress", "retiro"
  carrier        String
  service        String?
  cost           Int
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  externalId     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
